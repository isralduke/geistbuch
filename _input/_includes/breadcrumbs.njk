<nav class="navigation breadcrumbs" aria-label="Breadcrumbs">
	<ul role="list">
		{# Only show breadcrumbs if we're not on the home page #}
		{% if page.url != '/' %}
		<li role="listitem">
			<a href="/">Home</a>
		</li>

		{% if parent %}
			{# Extract book directory from the current page URL #}
			{# URL format: /books/08-ruth/01/ -> extract /books/08-ruth/ #}
			{% set urlParts = page.url | split('/') %}
			{% set bookDir = urlParts[2] %}
			{% if bookDir %}
				<li role="listitem">
					<a href="/books/{{ bookDir }}/">{{ parent }}</a>
				</li>
			{% endif %}
		{% endif %}

		{# Current page - not a link #}
		<li role="listitem" aria-current="page">
		{% if parent and title %}
				Chapter {{ title }}
			{% else %}
			{{ title }}
		{% endif %}
		</li>
		{% endif %}
	</ul>
</nav>
