---
layout: _base.njk
---

{{ content | stripGeneratedBlock | safe }}

{% set verseGroups = verses | groupVerses %}
{% if verseGroups.length %}
<nav class="navigation topic-verses" aria-label="Verses for this topic">
	{% for g in verseGroups %}
		<h2>{{ g.group or "Verses" }}</h2>
		<ul role="list">
			{% for item in g.refs %}
				{% set entry = item | normalizeVerseEntry %}
				{% set resolved = entry.ref | resolveVerseRef(books, collections) %}
				<li>
					<a href="{{ resolved.url }}">{{ resolved.verseLabel }}</a>
					{% if entry.note %}<span class="verse-note">{{ entry.note }}</span>{% endif %}
				</li>
			{% endfor %}
		</ul>
	{% endfor %}
</nav>
{% endif %}

<nav class="navigation breadcrumbs-back" aria-label="Back to topics">
	<a href="/topics/">← All topics</a>
</nav>
